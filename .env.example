# Copy to .env. Never commit live secrets. Use URL-safe random hex for DB password.
POSTGRES_USER=void
POSTGRES_DB=void
POSTGRES_PASSWORD=
KNOWLEDGE_API_TOKEN=
WEB_PORT=3000
# Runtime web profile: self-hosted uses only your own API key; hosted uses accounts and credits.
DEPLOYMENT_MODE=self-hosted
# Optional Caddy deployment: bare hostname, no scheme/path.
SITE_DOMAIN=
# Local scripts use SQLite unless DATABASE_URL is explicitly exported.
# DATABASE_URL=sqlite:////absolute/path/to/void-terminal/data/catalog.sqlite
KNOWLEDGE_URL=http://127.0.0.1:8000
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Additional trusted HTTPS origins, comma-separated; no path/trailing slash.
# Compatible providers require BOTH BASE_URL and its exact origin here.
# DEEPSEEK_BASE_URL=https://models.example.com/v1
# DEEPSEEK_ALLOWED_BASE_URLS=https://models.example.com
DEEPSEEK_ALLOWED_BASE_URLS=
DEEPSEEK_MODEL=deepseek-flash
# Hosted-only configuration. Self-hosted ignores server keys and all account/shared flags.
# Server key is used only for explicitly enabled, authenticated shared mode. BYOK stays in page memory.
DEEPSEEK_API_KEY=
SHARED_MODE_ENABLED=false
SHARED_DAILY_TOKEN_BUDGET=0
SESSION_SECRET=
# Production shared mode requires the exact public HTTPS origin (no path/trailing slash).
# Example: PUBLIC_APP_ORIGIN=https://void.example.com
# Hosted npm dev requires the exact browser origin (e.g. http://127.0.0.1:3000).
# Production Docker hosted mode requires HTTPS. Self-hosted BYOK may leave empty.
PUBLIC_APP_ORIGIN=
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Build semantic dependencies into both knowledge and ingest images only when needed.
# Set true and rebuild before prepare-embeddings; then enable EMBEDDING_ENABLED.
KNOWLEDGE_SEMANTIC_BUILD=false
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Hosted email-code trial. Both services must enable this; shared mode always requires login.
ACCOUNT_TRIAL_ENABLED=false
# Supabase project HTTPS origin and NEW publishable key (sb_publishable_...).
# Never use a secret/service-role key here. Keep these server environment only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Start invitation-only. Comma-separated email addresses; * explicitly opens public signup.
TRIAL_ALLOWED_EMAILS=
# One-time grant per verified account; changing this affects only NEW accounts.
ACCOUNT_TRIAL_CREDITS=20
# Local knowledge process only. Compose uses its dedicated accounts volume automatically.
# Keep outside the corpus directory and include in backups (SQLite online backup API).
ACCOUNT_DATABASE_PATH=
