  "narrative": {
    "northStar": "原作风格终端",
    "overview": "界面以《原神》游戏内菜单和须弥场景为视觉参照：风景、徽记、细金线、纸面和蓝灰文字共同构成可阅读的资料终端。游戏感与装饰性是明确的方向，但内容、操作状态和来源仍需清楚辨认。\n\n共享外壳使用蓝灰与暖纸色；万象集录和群星图鉴则在同一背景上使用更接近游戏菜单的嵌线面板、物品稀有度和元素色。保留这两种已有层次，不把单个模块的颜色当成所有页面的默认值。",
    "keyCharacteristics": ["须弥风景与原作相关图标提供世界感，纸面承载阅读和操作。", "蓝灰字色、暖纸底色、细金线和叶形徽记贯穿共享外壳。", "图鉴用游戏菜单式的分类、选中态、图像、稀有度或元素色组织内容。", "浅色与深色主题、中文与英文以及桌面与手机均有对应处理。"],
    "rules": [],
    "dos": ["Do 以现有游戏内菜单与须弥场景为参照，使用纸面、蓝灰文字和适量金色细节。", "Do 使用主题变量，并同时检查深色、移动端、键盘焦点和减少动态效果。", "Do 对稀有度、元素、选中和不可用状态使用已有模块语义与可辨认的文字或图标。", "Do 保留可阅读的正文层级、独立滚动区域和可追溯的来源入口。"],
    "donts": ["Don't 把图鉴的局部色彩或页面布局直接推广为全站默认规范。", "Don't 将标题专用的字体子集当作支持所有正文字符的通用字体。", "Don't 仅用颜色传达元素、选中或错误状态，也不要移除键盘焦点提示。", "Don't 为填补视觉空缺而臆造原作图标、素材或缺失数据。"]
  }
