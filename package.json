{
  "name": "void-terminal",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @void-terminal/web",
    "build": "npm run build --workspace @void-terminal/web",
    "start": "npm run start --workspace @void-terminal/web",
    "typecheck": "npm run typecheck --workspace @void-terminal/web",
    "test": "npm run test --workspace @void-terminal/web",
    "test:e2e": "npm run test:e2e --workspace @void-terminal/web"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  }
}
